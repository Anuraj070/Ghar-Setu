# GharSetu Environment Configuration

# Server Port (Python FastAPI defaults to 8000, Node Express defaults to 3000)
PORT=8000

# Security: Secret Key used for PBKDF2 salt derivation and signed HMAC auth sessions
# In production, set a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=gharsetu-super-secret-key-2026

# Optional: Google Gemini API Key for real-time generative AI scoping
# If left unset, GharSetu runs with its offline CPWD-benchmarked deterministic heuristics engine
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: External Cloud Database (Supabase / PostgreSQL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
